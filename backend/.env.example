PORT=5000
JWT_SECRET=change_me_to_a_strong_secret

# Use Atlas or local Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/medicare
USE_IN_MEMORY_DB=false
FORCE_HTTPS=false
# Comma-separated allowed origins for browser requests (leave empty to allow all in dev)
CORS_ORIGINS=

# Google login (optional)
GOOGLE_CLIENT_ID=

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
NOTIFY_TO_NUMBER=
AMBULANCE_CAN_DISPATCH=true

# AI (optional)
# Provider selection: auto | groq | gemini
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Email (optional)
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telemedicine / WebRTC (Phase 2)
# Comma-separated URLs
TELEMEDICINE_STUN_SERVERS=stun:stun.l.google.com:19302
TELEMEDICINE_TURN_SERVERS=
TELEMEDICINE_TURN_USERNAME=
TELEMEDICINE_TURN_CREDENTIAL=
# Optional: fetch short-lived TURN/STUN servers from Twilio Network Traversal API
TELEMEDICINE_TWILIO_ICE_ENABLED=false
TELEMEDICINE_TWILIO_ICE_TTL=3600
